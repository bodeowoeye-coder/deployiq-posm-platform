NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
SUPABASE_STORAGE_BUCKET=deployment-photos
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.2
COMPANY_NAME=Your Company Name
COMPANY_LOGO_URL=https://your-domain.com/logo.png
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only transactional email provider used by onboarding OTP, secure
# account-setup links, and workspace-ready notifications.
DEPLOYIQ_TRANSACTIONAL_EMAIL_PROVIDER=zeptomail
DEPLOYIQ_TRANSACTIONAL_EMAIL_ENDPOINT=https://api.zeptomail.com/v1.1/email
DEPLOYIQ_TRANSACTIONAL_EMAIL_TOKEN=
DEPLOYIQ_TRANSACTIONAL_EMAIL_FROM_ADDRESS=
DEPLOYIQ_TRANSACTIONAL_EMAIL_FROM_NAME=DeployIQ
# Dedicated server-side key for encrypting customer-created passwords during
# the short OTP handoff. Use a strong random value in production.
ONBOARDING_PASSWORD_ENCRYPTION_KEY=
# Local/test only. Enables "Activate test invitation" in User Management. Ignored when NODE_ENV/VERCEL_ENV/DEPLOYIQ_RUNTIME_ENV is production.
DEPLOYIQ_ENABLE_TEST_INVITATION_ACCEPTANCE=0
# Local/test only. Forces the mobile login carousel to render on every visit. Ignored when NODE_ENV is production.
NEXT_PUBLIC_DEPLOYIQ_ALWAYS_SHOW_LOGIN_CAROUSEL=0
DEPLOYIQ_PROVISIONING_AGENT_ENABLED=0
DEPLOYIQ_PROVISIONING_AGENT_MODE=shadow
DEPLOYIQ_PROVISIONING_AGENT_PRODUCTS=retail
DEPLOYIQ_PROVISIONING_AGENT_EXECUTION_ENABLED=0
DEPLOYIQ_PROVISIONING_AGENT_PROVIDER=deterministic
DEPLOYIQ_PROVISIONING_AGENT_MODEL=gpt-5.4-mini
DEPLOYIQ_PROVISIONING_AGENT_TIMEOUT_MS=15000
DEPLOYIQ_PROVISIONING_AGENT_MAX_RETRIES=1
# Server-only. Never use NEXT_PUBLIC_ for provider credentials.
OPENAI_API_KEY=
