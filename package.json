{
  "name": "ai-deployment-reporting",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:staging": "node scripts/run-staging-dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:playwright": "npx playwright test tests/gcpl-submission-validation.spec.ts",
    "test:reset-onboarding": "node scripts/reset-onboarding-test.mjs",
    "seed:admin": "node scripts/seed-test-client.mjs admin",
    "seed:godrej-client": "node scripts/seed-test-client.mjs godrej-client",
    "seed:darling-client": "node scripts/seed-test-client.mjs darling-client",
    "seed:test-client": "node scripts/seed-test-client.mjs",
    "seed:installer": "node scripts/seed-test-client.mjs installer",
    "staging:bootstrap": "node --env-file=.env.staging.local scripts/bootstrap-staging-database.mjs",
    "staging:verify": "node --env-file=.env.staging.local scripts/verify-staging-baseline.mjs",
    "staging:seed-reference": "node --env-file=.env.staging.local scripts/bootstrap-staging-database.mjs --reference",
    "staging:seed-fixtures": "node --env-file=.env.staging.local scripts/bootstrap-staging-database.mjs --fixtures",
    "staging:test": "node --test tests/staging-foundation.test.mjs",
    "staging:test-guard": "node --test --test-name-pattern=guard tests/staging-foundation.test.mjs",
    "db:local:bootstrap": "node scripts/bootstrap-disposable-local-database.mjs --rehearsals=1",
    "db:local:rehearse": "node scripts/bootstrap-disposable-local-database.mjs --rehearsals=2",
    "db:local:verify": "node scripts/verify-local-database-baseline.mjs",
    "db:local:test": "node --test tests/database-baseline-recovery.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.468.0",
    "next": "^14.2.23",
    "openai": "^4.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "sharp": "^0.35.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
