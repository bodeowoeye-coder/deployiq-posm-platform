# E1D uses a dedicated Supabase project and a separate generated Vercel HTTPS host.
# Copy to .env.uat.local only after both cloud projects receive explicit approval.
DEPLOYIQ_ENVIRONMENT=uat
DEPLOYIQ_UAT_PROJECT_REF=<20_CHARACTER_UAT_PROJECT_REF>
SUPABASE_PROJECT_REF=<20_CHARACTER_UAT_PROJECT_REF>
DEPLOYIQ_ALLOWED_MUTATION_PROJECT_REFS=<20_CHARACTER_UAT_PROJECT_REF>
NEXT_PUBLIC_SUPABASE_URL=https://<20_CHARACTER_UAT_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<UAT_PUBLISHABLE_OR_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<UAT_SECRET_OR_SERVICE_ROLE_KEY>
SUPABASE_DB_URL=<UAT_POSTGRESQL_CONNECTION_STRING>
NEXT_PUBLIC_APP_URL=https://<GENERATED_UAT_HOSTNAME>.vercel.app
NEXT_PUBLIC_SITE_URL=https://<GENERATED_UAT_HOSTNAME>.vercel.app
DEPLOYIQ_APP_URL=https://<GENERATED_UAT_HOSTNAME>.vercel.app
DEPLOYIQ_RUNTIME_ENV=uat
SUPABASE_STORAGE_BUCKET=build-runtime-evidence
ONBOARDING_PASSWORD_ENCRYPTION_KEY=<UAT_ONLY_RANDOM_ENCRYPTION_KEY>
NEXT_PUBLIC_DEPLOYIQ_ALWAYS_SHOW_LOGIN_CAROUSEL=0
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=1
NEXT_PUBLIC_ENABLE_SELF_SERVICE_ONBOARDING=0
DEPLOYIQ_WORKSPACE_WILDCARD_ROUTING_ENABLED=0
DEPLOYIQ_PROVISIONING_AGENT_ENABLED=0
DEPLOYIQ_PROVISIONING_AGENT_EXECUTION_ENABLED=0
# A dedicated UAT provider/token is required only if email-delivery scenarios are approved.
DEPLOYIQ_TRANSACTIONAL_EMAIL_PROVIDER=<UAT_TRANSACTIONAL_EMAIL_PROVIDER>
DEPLOYIQ_TRANSACTIONAL_EMAIL_ENDPOINT=<UAT_TRANSACTIONAL_EMAIL_ENDPOINT>
DEPLOYIQ_TRANSACTIONAL_EMAIL_TOKEN=<UAT_TRANSACTIONAL_EMAIL_TOKEN>
DEPLOYIQ_TRANSACTIONAL_EMAIL_FROM_ADDRESS=<UAT_TRANSACTIONAL_EMAIL_FROM_ADDRESS>
DEPLOYIQ_TRANSACTIONAL_EMAIL_FROM_NAME=DeployIQ UAT
E1D_UAT_PASSWORD=<UAT_SYNTHETIC_ACCOUNT_PASSWORD>
E1D_UAT_MANIFEST_PATH=.e1d-uat-manifest.json
DEPLOYIQ_CONFIRM_DESTRUCTIVE_OPERATION=NO
DEPLOYIQ_CONFIRM_REMOTE_UAT_MUTATION=NO
